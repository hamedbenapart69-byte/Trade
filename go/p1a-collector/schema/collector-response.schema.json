{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trade.example.invalid/schemas/p1a-collector-v1.schema.json",
  "title": "P1-A Go Collector Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timeframe", "generated_at_utc", "collection_elapsed_ms", "results"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "timeframe": {"const": "15m"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "collection_elapsed_ms": {"type": "integer", "minimum": 0},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "timeframe", "data_classification", "volume_unit", "provider", "status", "candles", "errors"],
        "properties": {
          "symbol": {"type": "string", "pattern": "^[A-Z0-9]+USDT$"},
          "timeframe": {"const": "15m"},
          "data_classification": {"enum": ["REAL", "PROXY", "UNAVAILABLE"]},
          "volume_unit": {"enum": ["CONTRACTS", "BASE_ASSET", "UNAVAILABLE"]},
          "provider": {"type": "string"},
          "status": {"enum": ["OK", "UNAVAILABLE"]},
          "candles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["timestamp", "open", "high", "low", "close", "volume"],
              "properties": {
                "timestamp": {"type": "integer", "minimum": 0},
                "open": {"type": "number", "exclusiveMinimum": 0},
                "high": {"type": "number", "exclusiveMinimum": 0},
                "low": {"type": "number", "exclusiveMinimum": 0},
                "close": {"type": "number", "exclusiveMinimum": 0},
                "volume": {"type": "number", "minimum": 0}
              }
            }
          },
          "errors": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "OK"}}},
            "then": {
              "properties": {
                "data_classification": {"const": "REAL"},
                "volume_unit": {"enum": ["CONTRACTS", "BASE_ASSET"]},
                "provider": {"enum": ["okx", "bybit"]},
                "candles": {"minItems": 1}
              }
            },
            "else": {
              "properties": {
                "data_classification": {"const": "UNAVAILABLE"},
                "volume_unit": {"const": "UNAVAILABLE"},
                "provider": {"const": ""},
                "candles": {"maxItems": 0}
              }
            }
          }
        ]
      }
    }
  }
}
