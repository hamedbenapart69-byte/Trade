{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/l2-status.v1.schema.json",
  "title": "CFSS L2 Status Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "source_schema_version",
    "source_run_id",
    "created_at_epoch_ms",
    "instruments",
    "artifact_sha256"
  ],
  "properties": {
    "artifact_type": {
      "const": "cfss_l2_status_v1"
    },
    "source_schema_version": {
      "const": "1.0.0"
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_epoch_ms": {
      "type": "integer",
      "minimum": 1
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrument_id",
          "symbol",
          "provider_id",
          "state",
          "reason_code",
          "data_quality",
          "confidence_status",
          "actionable",
          "latest_candle_timestamp_ms"
        ],
        "properties": {
          "instrument_id": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "BUY_NOW",
              "SELL_NOW",
              "CONDITIONAL_BUY",
              "CONDITIONAL_SELL",
              "WATCHLIST",
              "NO_QUALIFIED_SETUP",
              "MARKET_DATA_DEGRADED"
            ]
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "data_quality": {
            "enum": [
              "REAL",
              "PARTIAL",
              "PROXY",
              "UNAVAILABLE"
            ]
          },
          "confidence_status": {
            "enum": [
              "NOT_CALIBRATED",
              "CALIBRATED"
            ]
          },
          "actionable": {
            "type": "boolean"
          },
          "latest_candle_timestamp_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
