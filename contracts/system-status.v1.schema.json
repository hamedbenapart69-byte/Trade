{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFSS System Status Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scan_id",
    "generated_at_utc",
    "run_status",
    "provider_status",
    "path_statuses",
    "generator_statuses",
    "telegram_send_status",
    "telegram_receive_test_status",
    "telegram_message_ids",
    "telegram_last_update_id",
    "error_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scan_id": {
      "type": "string",
      "pattern": "^scan-[0-9a-f]{64}$"
    },
    "generated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "updated_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "run_status": {
      "enum": [
        "L1_L2_PASS",
        "DATA_DEGRADED",
        "L1_L2_L3_PASS",
        "L3_FAILED",
        "STAGE1_CONTROLLED_ACCEPTANCE_PASS"
      ]
    },
    "provider_status": {
      "type": "object"
    },
    "path_statuses": {
      "type": "object"
    },
    "generator_statuses": {
      "type": "object"
    },
    "telegram_send_status": {
      "enum": [
        "NOT_ATTEMPTED",
        "DELIVERED",
        "RETRYABLE_FAILURE",
        "PERMANENT_FAILURE",
        "DELIVERY_UNKNOWN"
      ]
    },
    "telegram_receive_test_status": {
      "enum": [
        "NOT_REQUESTED",
        "RECEIVED_PROCESSED",
        "NO_UPDATE_RECEIVED",
        "UNAVAILABLE",
        "FAILED"
      ]
    },
    "telegram_message_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "telegram_last_update_id": {
      "type": "integer",
      "minimum": 0
    },
    "error_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
