{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/cfss/l1-market-data.v1.schema.json",
  "title": "CFSS L1 Market Data Contract v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "producer",
    "acquired_at_utc",
    "window",
    "provider",
    "instruments",
    "universe",
    "provider_health",
    "fear_greed",
    "scan_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "source_commit"
      ],
      "properties": {
        "name": {
          "enum": [
            "cfss-python-l1-exporter",
            "cfss-cpp-l1-collector"
          ]
        },
        "version": {
          "type": "string"
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "acquired_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeframe",
        "start_ms",
        "end_ms"
      ],
      "properties": {
        "timeframe": {
          "const": "1h"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 1
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_provider_id",
        "display_name",
        "fallback_used"
      ],
      "properties": {
        "primary_provider_id": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "fallback_used": {
          "type": "boolean"
        },
        "fallback_provider_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "instruments": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instrument_id",
          "unified_symbol",
          "base",
          "quote",
          "settle",
          "contract_type",
          "contract_size",
          "provider_id",
          "timeframe",
          "candles",
          "funding",
          "open_interest",
          "availability",
          "coverage",
          "errors",
          "contract_multiplier",
          "contract_value_currency",
          "tick_size",
          "lot_size",
          "min_size",
          "listing_time_ms",
          "turnover_24h_usd",
          "liquidity_threshold_usd",
          "liquidity_status"
        ],
        "properties": {
          "instrument_id": {
            "type": "string",
            "minLength": 1
          },
          "unified_symbol": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "settle": {
            "type": "string",
            "minLength": 1
          },
          "contract_type": {
            "const": "linear_perpetual"
          },
          "contract_size": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "provider_id": {
            "type": "string",
            "minLength": 1
          },
          "timeframe": {
            "const": "1h"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ohlcv_endpoint",
              "funding_endpoint",
              "open_interest_endpoint",
              "retrieved_at_utc",
              "instrument_endpoint",
              "ticker_endpoint"
            ],
            "properties": {
              "ohlcv_endpoint": {
                "type": "string"
              },
              "funding_endpoint": {
                "type": "string"
              },
              "open_interest_endpoint": {
                "type": "string"
              },
              "retrieved_at_utc": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "instrument_endpoint": {
                "type": "string"
              },
              "ticker_endpoint": {
                "type": "string"
              },
              "provider_instrument_id": {
                "type": "string",
                "minLength": 1
              },
              "fallback_used": {
                "type": "boolean"
              },
              "primary_provider_error": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "candles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "timestamp_ms",
                "open",
                "high",
                "low",
                "close",
                "volume",
                "closed",
                "retrieved_at_utc",
                "volume_unit",
                "volume_base",
                "volume_base_currency",
                "volume_quote",
                "volume_quote_currency",
                "price_currency"
              ],
              "properties": {
                "timestamp_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "open": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "high": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "low": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "close": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "volume": {
                  "type": "number",
                  "minimum": 0
                },
                "closed": {
                  "const": true
                },
                "retrieved_at_utc": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "volume_unit": {
                  "const": "contracts"
                },
                "volume_base": {
                  "type": "number",
                  "minimum": 0
                },
                "volume_base_currency": {
                  "type": "string",
                  "minLength": 1
                },
                "volume_quote": {
                  "type": "number",
                  "minimum": 0
                },
                "volume_quote_currency": {
                  "type": "string",
                  "minLength": 1
                },
                "price_currency": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "funding": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "timestamp_ms",
                "funding_rate",
                "mark_price",
                "retrieved_at_utc",
                "funding_rate_unit",
                "mark_price_currency"
              ],
              "properties": {
                "timestamp_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "funding_rate": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "mark_price": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "retrieved_at_utc": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "funding_rate_unit": {
                  "const": "fraction"
                },
                "mark_price_currency": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "open_interest": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "timestamp_ms",
                "open_interest",
                "open_interest_value_usd",
                "retrieved_at_utc",
                "open_interest_unit",
                "open_interest_base",
                "open_interest_base_currency",
                "open_interest_value_currency"
              ],
              "properties": {
                "timestamp_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "open_interest": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "open_interest_value_usd": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "exclusiveMinimum": 0
                },
                "retrieved_at_utc": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "open_interest_unit": {
                  "const": "contracts"
                },
                "open_interest_base": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "open_interest_base_currency": {
                  "type": "string",
                  "minLength": 1
                },
                "open_interest_value_currency": {
                  "const": "USD"
                }
              }
            }
          },
          "availability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ohlcv",
              "funding",
              "open_interest"
            ],
            "properties": {
              "ohlcv": {
                "enum": [
                  "AVAILABLE",
                  "PARTIAL",
                  "UNAVAILABLE"
                ]
              },
              "funding": {
                "enum": [
                  "AVAILABLE",
                  "PARTIAL",
                  "UNAVAILABLE"
                ]
              },
              "open_interest": {
                "enum": [
                  "AVAILABLE",
                  "PARTIAL",
                  "UNAVAILABLE"
                ]
              }
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ohlcv_rows",
              "funding_rows",
              "open_interest_rows",
              "ohlcv_coverage_pct",
              "funding_latest_age_ms",
              "funding_max_age_ms",
              "funding_freshness_status",
              "open_interest_latest_age_ms",
              "open_interest_max_age_ms",
              "open_interest_freshness_status"
            ],
            "properties": {
              "ohlcv_rows": {
                "type": "integer",
                "minimum": 0
              },
              "funding_rows": {
                "type": "integer",
                "minimum": 0
              },
              "open_interest_rows": {
                "type": "integer",
                "minimum": 0
              },
              "ohlcv_coverage_pct": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "funding_coverage_days": {
                "type": "number",
                "minimum": 0
              },
              "open_interest_coverage_days": {
                "type": "number",
                "minimum": 0
              },
              "funding_latest_age_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "funding_max_age_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 86400000
              },
              "funding_freshness_status": {
                "enum": [
                  "FRESH",
                  "STALE",
                  "UNAVAILABLE"
                ]
              },
              "open_interest_latest_age_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "open_interest_max_age_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10800000
              },
              "open_interest_freshness_status": {
                "enum": [
                  "FRESH",
                  "STALE",
                  "UNAVAILABLE"
                ]
              }
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contract_multiplier": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "contract_value_currency": {
            "type": "string",
            "minLength": 1
          },
          "tick_size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "lot_size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "min_size": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "listing_time_ms": {
            "type": "integer",
            "minimum": 1
          },
          "turnover_24h_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "liquidity_threshold_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "liquidity_status": {
            "enum": [
              "ELIGIBLE",
              "BELOW_THRESHOLD_PINNED"
            ]
          }
        }
      }
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_usdt_swap_count",
        "eligible_count",
        "selected_count",
        "target_count",
        "liquidity_threshold_usd",
        "selection_method",
        "selection_timestamp_utc",
        "selected_instrument_ids"
      ],
      "properties": {
        "declared_usdt_swap_count": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_count": {
          "type": "integer",
          "minimum": 0
        },
        "crypto_universe_status": {
          "const": "VERIFIED"
        },
        "crypto_universe_source": {
          "const": "coinpaprika"
        },
        "crypto_universe_symbol_count": {
          "type": "integer",
          "minimum": 500
        },
        "crypto_universe_symbols_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "excluded_non_crypto_count": {
          "type": "integer",
          "minimum": 0
        },
        "selected_count": {
          "type": "integer",
          "minimum": 0
        },
        "target_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "liquidity_threshold_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "selection_method": {
          "type": "string",
          "minLength": 1
        },
        "selection_timestamp_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "selected_instrument_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "crypto_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_type",
        "status",
        "provider_id",
        "source_endpoint",
        "attribution",
        "freshness_status",
        "fetched_at_ms",
        "retrieved_at_ms",
        "symbol_count",
        "symbols_sha256",
        "symbols"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "artifact_type": {
          "const": "cfss_crypto_universe_v1"
        },
        "status": {
          "enum": [
            "VERIFIED",
            "OWNER_CONFIGURED_CANDIDATE_SET"
          ]
        },
        "provider_id": {
          "enum": [
            "coinpaprika",
            "owner_config"
          ]
        },
        "source_endpoint": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "freshness_status": {
          "enum": [
            "LIVE",
            "CACHED",
            "STATIC_CONFIG"
          ]
        },
        "fetched_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "retrieved_at_ms": {
          "type": "integer",
          "minimum": 1
        },
        "symbol_count": {
          "type": "integer",
          "minimum": 9
        },
        "symbols_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "symbols": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9]{1,20}$"
          },
          "contains": {
            "const": "BTC"
          },
          "minContains": 1
        },
        "selection_status": {
          "const": "PROVISIONAL_NOT_FROZEN"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "provider_id": {
                "const": "coinpaprika"
              },
              "source_endpoint": {
                "const": "https://api.coinpaprika.com/v1/coins"
              },
              "attribution": {
                "const": "CoinPaprika"
              },
              "freshness_status": {
                "enum": [
                  "LIVE",
                  "CACHED"
                ]
              },
              "symbol_count": {
                "type": "integer",
                "minimum": 500
              },
              "symbols": {
                "type": "array",
                "minItems": 500,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{1,20}$"
                },
                "contains": {
                  "const": "BTC"
                },
                "minContains": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "OWNER_CONFIGURED_CANDIDATE_SET"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "selection_status"
            ],
            "properties": {
              "provider_id": {
                "const": "owner_config"
              },
              "source_endpoint": {
                "const": "config/universe.v21.1.candidate.json"
              },
              "attribution": {
                "const": "Owner-configured provisional candidate universe; not market data."
              },
              "freshness_status": {
                "const": "STATIC_CONFIG"
              },
              "symbol_count": {
                "const": 9
              },
              "symbols": {
                "type": "array",
                "minItems": 9,
                "maxItems": 9,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z0-9]{1,20}$"
                },
                "contains": {
                  "const": "BTC"
                },
                "minContains": 1
              },
              "selection_status": {
                "const": "PROVISIONAL_NOT_FROZEN"
              }
            }
          }
        }
      ]
    },
    "provider_health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "checked_at_utc",
        "providers"
      ],
      "properties": {
        "schema_version": {
          "const": "1.1.0"
        },
        "checked_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider_id",
              "fallback_rank",
              "endpoint",
              "checked_at_utc",
              "connectivity_status",
              "http_status",
              "transport_status",
              "adapter_status",
              "fallback_status",
              "fallback_equivalence",
              "fallback_reason"
            ],
            "properties": {
              "provider_id": {
                "type": "string"
              },
              "fallback_rank": {
                "type": "integer",
                "minimum": 1
              },
              "endpoint": {
                "type": "string"
              },
              "checked_at_utc": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "connectivity_status": {
                "enum": [
                  "HTTP_REACHABLE",
                  "UNAVAILABLE"
                ]
              },
              "http_status": {
                "type": "integer"
              },
              "transport_status": {
                "type": "string"
              },
              "adapter_status": {
                "enum": [
                  "IMPLEMENTED_PRIMARY",
                  "NOT_IMPLEMENTED",
                  "REFERENCE_ONLY",
                  "IMPLEMENTED_SECONDARY_PARTIAL"
                ]
              },
              "fallback_status": {
                "enum": [
                  "PRIMARY",
                  "UNAVAILABLE",
                  "NOT_IMPLEMENTED",
                  "REFERENCE_ONLY",
                  "AVAILABLE_PARTIAL"
                ]
              },
              "fallback_equivalence": {
                "enum": [
                  "NOT_PROVEN",
                  "PARTIAL",
                  "VERIFIED"
                ]
              },
              "fallback_reason": {
                "type": "string",
                "minLength": 1
              },
              "fallback_probe": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "symbol",
                  "ohlcv_rows",
                  "funding_rows",
                  "open_interest_rows",
                  "open_interest_coverage_days",
                  "open_interest_hourly_retention_days",
                  "equivalence",
                  "limitation",
                  "errors"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "PASS",
                      "FAIL"
                    ]
                  },
                  "symbol": {
                    "type": "string",
                    "minLength": 1
                  },
                  "ohlcv_rows": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "funding_rows": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "open_interest_rows": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "open_interest_coverage_days": {
                    "type": "number",
                    "minimum": 0
                  },
                  "open_interest_hourly_retention_days": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "equivalence": {
                    "const": "PARTIAL"
                  },
                  "limitation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "errors": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "circuit_breaker_state": {
                "enum": [
                  "CLOSED",
                  "OPEN",
                  "HALF_OPEN",
                  "NOT_APPLICABLE"
                ]
              }
            }
          }
        }
      }
    },
    "fear_greed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "retrieved_at_utc",
        "observations"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "status": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ]
        },
        "source_id": {
          "type": "string"
        },
        "source_endpoint": {
          "type": "string"
        },
        "retrieved_at_utc": {
          "type": "string",
