{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFSS Crypto Universe Reference (Verified Market or Owner-Configured Candidate Set)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "status",
    "provider_id",
    "source_endpoint",
    "attribution",
    "freshness_status",
    "fetched_at_ms",
    "retrieved_at_ms",
    "symbol_count",
    "symbols_sha256",
    "symbols"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "cfss_crypto_universe_v1"
    },
    "status": {
      "enum": [
        "VERIFIED",
        "OWNER_CONFIGURED_CANDIDATE_SET"
      ]
    },
    "provider_id": {
      "enum": [
        "coinpaprika",
        "owner_config"
      ]
    },
    "source_endpoint": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "freshness_status": {
      "enum": [
        "LIVE",
        "CACHED",
        "STATIC_CONFIG"
      ]
    },
    "fetched_at_ms": {
      "type": "integer",
      "minimum": 1
    },
    "retrieved_at_ms": {
      "type": "integer",
      "minimum": 1
    },
    "symbol_count": {
      "type": "integer",
      "minimum": 9
    },
    "symbols_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "symbols": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9]{1,20}$"
      },
      "contains": {
        "const": "BTC"
      },
      "minContains": 1
    },
    "selection_status": {
      "const": "PROVISIONAL_NOT_FROZEN"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "provider_id": {
            "const": "coinpaprika"
          },
          "source_endpoint": {
            "const": "https://api.coinpaprika.com/v1/coins"
          },
          "attribution": {
            "const": "CoinPaprika"
          },
          "freshness_status": {
            "enum": [
              "LIVE",
              "CACHED"
            ]
          },
          "symbol_count": {
            "type": "integer",
            "minimum": 500
          },
          "symbols": {
            "type": "array",
            "minItems": 500,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9]{1,20}$"
            },
            "contains": {
              "const": "BTC"
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "OWNER_CONFIGURED_CANDIDATE_SET"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "selection_status"
        ],
        "properties": {
          "provider_id": {
            "const": "owner_config"
          },
          "source_endpoint": {
            "const": "config/universe.v21.1.candidate.json"
          },
          "attribution": {
            "const": "Owner-configured provisional candidate universe; not market data."
          },
          "freshness_status": {
            "const": "STATIC_CONFIG"
          },
          "symbol_count": {
            "const": 9
          },
          "symbols": {
            "type": "array",
            "minItems": 9,
            "maxItems": 9,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9]{1,20}$"
            },
            "contains": {
              "const": "BTC"
            },
            "minContains": 1
          },
          "selection_status": {
            "const": "PROVISIONAL_NOT_FROZEN"
          }
        }
      }
    }
  ]
}
