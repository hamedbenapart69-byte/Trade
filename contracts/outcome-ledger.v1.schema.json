{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CFSS Immutable Closed Outcome Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "profile",
    "ledger_status",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "cfss_outcome_ledger_v1"
    },
    "profile": {
      "enum": [
        "DAILY_SWING",
        "INTRADAY_SCALP"
      ]
    },
    "reason": {
      "type": "string"
    },
    "ledger_status": {
      "enum": [
        "EMPTY",
        "AVAILABLE",
        "UNAVAILABLE"
      ]
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_id",
          "profile",
          "path",
          "regime",
          "closed_at_ms",
          "raw_score",
          "score_model_version",
          "win",
          "win_r",
          "loss_r",
          "fee_r",
          "slippage_r",
          "funding_r",
          "data_class",
          "cost_status",
          "symbol",
          "direction",
          "entry_reference",
          "entry_fill_reference",
          "entry_fill_time_ms",
          "entry_model",
          "execution_status",
          "stop_reference",
          "target_reference",
          "exit_reference",
          "decision_time_ms",
          "resolution",
          "resolution_timeframe",
          "source_scan_id",
          "source_l1_sha256",
          "outcome_kind",
          "resolution_data_sha256",
          "resolution_bars"
        ],
        "properties": {
          "signal_id": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "enum": [
              "DAILY_SWING",
              "INTRADAY_SCALP"
            ]
          },
          "path": {
            "enum": [
              "PLAN_A_LRT",
              "PLAN_A_NMT",
              "PLAN_B",
              "PLAN_C",
              "PLAN_H"
            ]
          },
          "regime": {
            "type": "string",
            "minLength": 1
          },
          "closed_at_ms": {
            "type": "integer",
            "minimum": 1
          },
          "raw_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "score_model_version": {
            "enum": [
              "LFS_V2_PROXY",
              "NSS_V2_PROXY"
            ]
          },
          "win": {
            "type": "boolean"
          },
          "win_r": {
            "type": "number",
            "minimum": 0
          },
          "loss_r": {
            "type": "number",
            "minimum": 0
          },
          "fee_r": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "slippage_r": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "funding_r": {
            "type": [
              "number",
              "null"
            ]
          },
          "data_class": {
            "enum": [
              "REAL",
              "PROXY"
            ]
          },
          "cost_status": {
            "enum": [
              "REAL",
              "PROXY",
              "UNAVAILABLE"
            ]
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "LONG",
              "SHORT"
            ]
          },
          "entry_reference": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "entry_fill_reference": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "entry_fill_time_ms": {
            "type": "integer",
            "minimum": 1,
            "description": "Timestamp of the first closed resolution candle used as the proxy entry fill."
          },
          "entry_model": {
            "const": "NEXT_BAR_OPEN_PROXY"
          },
          "execution_status": {
            "const": "NOT_EXECUTED"
          },
          "stop_reference": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "target_reference": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "exit_reference": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "decision_time_ms": {
            "type": "integer",
            "minimum": 1
          },
          "resolution": {
            "enum": [
              "STOP",
              "TARGET",
              "STOP_FIRST_SAME_BAR_AMBIGUITY",
              "TIME_EXPIRY"
            ]
          },
          "resolution_timeframe": {
            "enum": [
              "15m",
              "1h"
            ]
          },
          "source_scan_id": {
            "type": "string",
            "minLength": 1
          },
          "source_l1_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_universe_status": {
            "const": "VERIFIED"
          },
          "outcome_kind": {
            "const": "HYPOTHESIS_PROXY"
          },
          "resolution_data_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "resolution_bars": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "timestamp_ms",
                "open",
                "high",
                "low",
                "close"
              ],
              "properties": {
                "timestamp_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "open": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "high": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "low": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "close": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          "cost_model_id": {
            "const": "SHADOW_COST_PROXY_V1"
          },
          "fee_rate_per_side": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 0.01
          },
          "slippage_rate_per_side": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 0.02
          },
          "funding_source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "OKX_PUBLIC_FUNDING_HISTORY",
              null
            ]
          },
          "cost_source_run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "cost_source_scan_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "cost_source_l1_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "fee_assumption_class": {
            "const": "ASSUMED"
          },
          "fee_assumption_ref": {
            "const": "V18.2_G3_REFERENCE_FEE_0.04_PERCENT_ASSUMED_PER_SIDE"
          },
          "slippage_assumption_class": {
            "const": "PROXY"
          },
          "slippage_proxy_method": {
            "const": "FIXED_RATE_NOT_MEASURED_FROM_ORDER_BOOK"
          },
          "slippage_source_status": {
            "const": "UNAVAILABLE_MARKET_IMPACT_MEASUREMENT"
          },
          "cost_as_of_time_ms": {
            "type": "integer",
            "minimum": 1,
            "description": "L1 source snapshot event-time upper bound used for this cost calculation; not wall-clock processing time."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "cost_status": {
                  "const": "PROXY"
                }
              },
              "required": [
                "cost_status"
              ]
            },
            "then": {
              "required": [
                "cost_model_id",
                "fee_rate_per_side",
                "fee_assumption_class",
                "fee_assumption_ref",
                "slippage_rate_per_side",
                "slippage_assumption_class",
                "slippage_proxy_method",
                "slippage_source_status",
                "funding_source",
                "cost_source_run_id",
                "cost_source_scan_id",
                "cost_source_l1_sha256",
                "cost_as_of_time_ms"
              ],
              "properties": {
                "fee_r": {
                  "type": "number",
                  "minimum": 0
                },
                "slippage_r": {
                  "type": "number",
                  "minimum": 0
                },
                "funding_r": {
                  "type": "number"
                },
                "fee_rate_per_side": {
                  "const": 0.0004
                },
                "slippage_rate_per_side": {
                  "const": 0.001
                },
                "cost_source_run_id": {
                  "type": "string",
                  "minLength": 1
                },
                "cost_source_scan_id": {
                  "type": "string",
                  "minLength": 1
                },
                "cost_source_l1_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "cost_as_of_time_ms": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "cost_status": {
                  "const": "UNAVAILABLE"
                }
              },
              "required": [
                "cost_status"
              ]
            },
            "then": {
              "properties": {
                "fee_r": {
                  "type": "null"
                },
                "slippage_r": {
                  "type": "null"
                },
                "funding_r": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "cost_backfilled_this_run": {
      "type": "integer",
      "minimum": 0
    },
    "cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "data_class",
        "fee_rate_per_side",
        "slippage_rate_per_side",
        "funding_source",
        "funding_coverage_tolerance_hours"
      ],
      "properties": {
        "id": {
          "const": "SHADOW_COST_PROXY_V1"
        },
        "data_class": {
          "const": "PROXY"
        },
        "fee_rate_per_side": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.01
        },
        "slippage_rate_per_side": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.02
        },
        "funding_source": {
          "const": "OKX_PUBLIC_FUNDING_HISTORY"
        },
        "funding_coverage_tolerance_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ledger_status": {
            "const": "EMPTY"
          }
        }
      },
      "then": {
        "properties": {
          "outcomes": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ledger_status": {
            "const": "AVAILABLE"
          }
        }
      },
      "then": {
        "properties": {
          "outcomes": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ]
}
