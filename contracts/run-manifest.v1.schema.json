{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/run-manifest.v1.schema.json",
  "title": "CFSS V18.2 Pipeline Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "scan_id",
    "run_timestamp_utc",
    "repository_commit",
    "branch",
    "document_version",
    "compiler_id",
    "compiler_version",
    "build_id",
    "configuration_version",
    "configuration_hash",
    "dataset_version",
    "dataset_hash",
    "provider_status",
    "profile",
    "path_statuses",
    "generator_statuses",
    "run_status",
    "start_time_utc",
    "end_time_utc",
    "error_summary",
    "retry_summary",
    "artifact_manifest",
    "telegram_send_status",
    "telegram_receive_test_status",
    "telegram_message_ids",
    "telegram_last_update_id"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "scan_id": {
      "type": "string",
      "pattern": "^scan-[0-9a-f]{64}$"
    },
    "run_timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repository_commit": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "document_version": {
      "const": "V18.2"
    },
    "compiler_id": {
      "type": "string",
      "minLength": 1
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1
    },
    "build_id": {
      "type": "string",
      "minLength": 1
    },
    "configuration_version": {
      "type": "string",
      "minLength": 1
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "dataset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_status": {
      "type": "object",
      "required": [
        "checked_at_utc",
        "providers"
      ],
      "properties": {
        "checked_at_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "provider_id",
              "connectivity_status",
              "fallback_status",
              "fallback_reason"
            ],
            "properties": {
              "provider_id": {
                "type": "string"
              },
              "connectivity_status": {
                "enum": [
                  "HTTP_REACHABLE",
                  "UNAVAILABLE"
                ]
              },
              "fallback_status": {
                "enum": [
                  "PRIMARY",
                  "UNAVAILABLE",
                  "NOT_IMPLEMENTED",
                  "REFERENCE_ONLY"
                ]
              },
              "fallback_reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol_target",
        "selected_symbols",
        "years",
        "timeframe",
        "liquidity_threshold_usd"
      ],
      "properties": {
        "symbol_target": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "selected_symbols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "years": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "timeframe": {
          "const": "1h"
        },
        "liquidity_threshold_usd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "path_statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B",
        "C",
        "H"
      ],
      "properties": {
        "A": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        },
        "B": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        },
        "C": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        },
        "H": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        }
      }
    },
    "generator_statuses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "H1",
        "H2",
        "H3",
        "H4",
        "H5",
        "H6",
        "H7"
      ],
      "properties": {
        "H1": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        },
        "H2": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        },
        "H3": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        },
        "H4": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        },
        "H5": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        },
        "H6": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        },
        "H7": {
          "enum": [
            "NOT_STARTED",
            "ACTIVE",
            "PASS",
            "FAIL",
            "DISABLED",
            "UNAVAILABLE"
          ]
        }
      }
    },
    "run_status": {
      "enum": [
        "L1_L2_PASS",
        "DATA_DEGRADED",
        "L1_L2_L3_PASS",
        "L3_FAILED",
        "STAGE1_CONTROLLED_ACCEPTANCE_PASS"
      ]
    },
    "start_time_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "end_time_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "error_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retry_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_request_attempts",
        "http_failed_attempts",
        "http_retry_attempts",
        "exhausted_requests",
        "telegram_inbound_polls",
        "telegram_send_attempts_total_for_scan",
        "telegram_retry_attempts_total_for_scan"
      ],
      "properties": {
        "http_request_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "http_failed_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "http_retry_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "exhausted_requests": {
          "type": "integer",
          "minimum": 0
        },
        "telegram_inbound_polls": {
          "type": "integer",
          "minimum": 0
        },
        "telegram_send_attempts_total_for_scan": {
          "type": "integer",
          "minimum": 0
        },
        "telegram_retry_attempts_total_for_scan": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "artifact_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "l1_market_data",
        "l2_status",
        "provider_health",
        "fear_greed"
      ],
      "properties": {
        "l1_market_data": {
          "$ref": "#/$defs/artifact"
        },
        "l2_status": {
          "$ref": "#/$defs/artifact"
        },
        "provider_health": {
          "$ref": "#/$defs/artifact"
        },
        "fear_greed": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "telegram_send_status": {
      "enum": [
        "NOT_ATTEMPTED",
        "DELIVERED",
        "RETRYABLE_FAILURE",
        "PERMANENT_FAILURE",
        "DELIVERY_UNKNOWN"
      ]
    },
    "telegram_receive_test_status": {
      "enum": [
        "NOT_REQUESTED",
        "RECEIVED_PROCESSED",
        "NO_UPDATE_RECEIVED",
        "UNAVAILABLE",
        "FAILED"
      ]
    },
    "telegram_message_ids": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "telegram_last_update_id": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
