{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/nss-v2-proxy.v1.schema.json",
  "title": "CFSS NSS V2 Proxy Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "version",
    "source_run_id",
    "source_scan_id",
    "decision_time_ms",
    "l1_sha256",
    "basis_sha256",
    "status",
    "reason",
    "instruments"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_type": {
      "const": "cfss_nss_v2_proxy"
    },
    "version": {
      "const": "NSS_V2_PROXY"
    },
    "source_run_id": {
      "type": "string",
      "minLength": 1
    },
    "source_scan_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_time_ms": {
      "type": "integer",
      "minimum": 1
    },
    "l1_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "basis_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "CALCULATED",
        "PARTIAL_OR_UNAVAILABLE"
      ]
    },
    "reason": {
      "type": "string"
    },
    "instruments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "status",
          "version",
          "data_class",
          "nss_long",
          "nss_short",
          "actionable",
          "confidence_status"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "CALCULATED",
              "UNAVAILABLE"
            ]
          },
          "version": {
            "const": "NSS_V2_PROXY"
          },
          "data_class": {
            "enum": [
              "PROXY",
              "UNAVAILABLE"
            ]
          },
          "actionable": {
            "const": false
          },
          "confidence_status": {
            "const": "NOT_CALIBRATED"
          },
          "nss_long": {
            "$ref": "#/$defs/direction"
          },
          "nss_short": {
            "$ref": "#/$defs/direction"
          }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "score",
        "data_class",
        "available_at_ms",
        "definition_id",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "data_class": {
          "const": "PROXY"
        },
        "available_at_ms": {
          "type": "integer",
          "minimum": 0
        },
        "definition_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "status",
        "score",
        "data_class",
        "component_coverage",
        "missing_count",
        "components",
        "actionable",
        "confidence_status"
      ],
      "properties": {
        "direction": {
          "enum": [
            "LONG",
            "SHORT"
          ]
        },
        "status": {
          "enum": [
            "CALCULATED",
            "UNAVAILABLE"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "data_class": {
          "enum": [
            "PROXY",
            "UNAVAILABLE"
          ]
        },
        "component_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available_scores",
            "required_scores"
          ],
          "properties": {
            "available_scores": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "required_scores": {
              "const": 5
            }
          }
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "components": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "actionable": {
          "const": false
        },
        "confidence_status": {
          "const": "NOT_CALIBRATED"
        }
      }
    }
  }
}
