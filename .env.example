# Required for operational API routes; use a long random secret.
CONTROL_API_TOKEN=replace-me-with-a-long-random-secret
CONTROL_DB_PATH=./data/control.db
ENABLE_N8N_EXECUTION=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_TIMEOUT_SECONDS=8

# Separate least-privilege credential for worker lease/finish endpoints
WORKER_API_TOKEN=replace-with-a-different-random-secret-at-least-24-chars
